{
  "name": "webhook_to_http",
  "triggers": [
    { "id": "t1", "type": "webhook", "path": "/hook/order", "method": "POST" }
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "httpRequest",
      "config": {
        "method": "POST",
        "url": "http://localhost:3002/echo",
        "headers": { "Authorization": "Bearer {{context.headers.authorization}}", "Content-Type": "application/json" },
        "body": { "orderId": "{{context.body.id}}", "total": "{{context.body.total}}" },
        "timeoutMs": 10000
      }
    },
    {
      "id": "n2",
      "type": "function",
      "config": { "code": "const prev = context.result; context.result = { echo: prev, received: true }; return context;" }
    }
  ],
  "connections": [
    { "from": { "id": "t1", "port": "main" }, "to": { "id": "n1", "port": "in" } },
    { "from": { "id": "n1", "port": "main" }, "to": { "id": "n2", "port": "in" } }
  ],
  "settings": { "onError": "stop", "retry": { "maxAttempts": 2, "backoffMs": 1000 } }
}
